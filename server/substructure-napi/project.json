{
  "name": "substructure-napi",
  "targets": {
    "build": {
      "command": "cargo build -p substructure-napi --release",
      "options": {
        "cwd": "."
      },
      "inputs": [
        "{projectRoot}/src/**",
        "{projectRoot}/Cargo.toml",
        "server/substructure-core/src/**"
      ],
      "outputs": ["server/target/release/libsubstructure_napi.dylib"],
      "cache": true
    }
  }
}
