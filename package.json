{
  "name": "substructure",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "build": "pnpm -r build && cargo build --release -p substructure-core",
    "dev": "pnpm -r --parallel dev",
    "dev:server": "cargo run -p substructure-core -- start",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "release": "scripts/release.sh"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["lefthook"]
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@napi-rs/cli": "3.5.1",
    "lefthook": "2.1.5",
    "typescript": "5.9.3"
  }
}
