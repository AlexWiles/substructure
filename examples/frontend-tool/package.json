{
  "name": "@substructure.ai/example-frontend-tool",
  "private": true,
  "type": "module",
  "scripts": {
    "build:client": "esbuild public/main.ts --bundle --format=esm --target=es2022 --outfile=public/main.js --external:@substructure.ai/runtime --log-level=warning",
    "watch:client": "esbuild public/main.ts --bundle --format=esm --target=es2022 --outfile=public/main.js --external:@substructure.ai/runtime --watch",
    "start": "pnpm build:client && tsx server.ts",
    "dev": "pnpm build:client && tsx watch server.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.0.4",
    "@substructure.ai/sdk": "link:../../packages/sdk",
    "hono": "4.6.14"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "esbuild": "0.24.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
