{
  "name": "@substructure.ai/sdk",
  "version": "0.1.15",
  "description": "TypeScript SDK for Substructure",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/substructureai/substructure#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/substructureai/substructure.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/substructureai/substructure/issues"
  },
  "keywords": [
    "substructure",
    "ai",
    "agents",
    "llm",
    "durable",
    "sdk"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "@source": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./embedded": {
      "@source": "./src/embedded.ts",
      "types": "./dist/embedded.d.ts",
      "import": "./dist/embedded.js"
    },
    "./ai": {
      "@source": "./src/ai.ts",
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.js"
    }
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@substructure.ai/runtime": "workspace:*",
    "ai": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@substructure.ai/runtime": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "ai": "^6.0.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
