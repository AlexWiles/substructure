{
    "$schema": "https://biomejs.dev/schemas/2.0.0/schema.json",
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "trailingCommas": "all"
        }
    },
    "files": {
        "includes": [
            "packages/**/*.{ts,tsx}",
            "examples/**/*.{ts,tsx}"
        ]
    }
}
