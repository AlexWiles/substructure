{
  "name": "server",
  "targets": {
    "build": {
      "dependsOn": ["@substructure.ai/dashboard:build"],
      "command": "cargo build --release",
      "options": {
        "cwd": "crates/server"
      },
      "inputs": [
        "{projectRoot}/src/**",
        "{projectRoot}/Cargo.toml",
        "dashboard/dist/**"
      ],
      "outputs": ["{projectRoot}/target/release/substructure"],
      "cache": true
    },
    "dev": {
      "command": "cargo run -- serve",
      "options": {
        "cwd": "crates/server"
      }
    },
    "check": {
      "command": "cargo check",
      "options": {
        "cwd": "crates/server"
      },
      "cache": true
    }
  }
}
