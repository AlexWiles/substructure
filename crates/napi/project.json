{
  "name": "substructure-napi",
  "targets": {
    "build": {
      "command": "pnpm run build",
      "options": {
        "cwd": "packages/runtime"
      },
      "inputs": [
        "{workspaceRoot}/crates/napi/src/**",
        "{workspaceRoot}/crates/napi/Cargo.toml",
        "{workspaceRoot}/crates/core/src/**",
        "{workspaceRoot}/crates/server/src/providers/**"
      ],
      "outputs": ["{workspaceRoot}/packages/runtime/src/substructure-napi.*.node"],
      "cache": true
    }
  }
}
